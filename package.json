{
  "name": "tai-protocol-training-hub",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort --configLoader runner",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke-check.mjs",
    "smoke:offline": "node scripts/smoke-check.mjs --skip-api",
    "bundle:check": "node scripts/check-bundle.mjs",
    "standards:check": "node scripts/check-standards.mjs",
    "ci:offline": "npm run typecheck && npm run test && npm run build && npm run bundle:check && npm run standards:check && npm run smoke:offline",
    "ci:online": "npm run ci:offline && npm run smoke",
    "release:check": "npm run ci:online"
  },
  "dependencies": {
    "@ton/core": "^0.61.0",
    "@tonconnect/ui-react": "^2.0.12",
    "buffer": "^6.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^2.1.9"
  }
}
